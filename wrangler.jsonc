{
  // Cloudflare Worker that serves the Eleventy build as static assets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mia-site",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Free *.workers.dev test address. Turn off once the real domain is connected.
  "workers_dev": true
}
