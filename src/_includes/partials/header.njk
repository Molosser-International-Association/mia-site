<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <img src="/assets/img/mia-emblem-light.png" alt="" width="72" height="72">
      <span class="brand-text">
        <span class="brand-short">{{ site.shortName }}</span>
        <span class="brand-long">{{ site.name }}</span>
      </span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {%- for item in site.nav %}
        {%- set current = (page.url == item.url) or (item.url != "/" and page.url.startsWith(item.url)) %}
        <li><a href="{{ item.url }}"{% if current %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
