<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="footer-name">{{ site.name }}</span>
      <span>Founded {{ site.established }} · {{ site.country }}</span>
      <span>&copy; {{ "now" | year }} {{ site.name }}</span>
    </div>
    <div class="footer-links">
      <div>
        <h2>Registry</h2>
        <ul>
          <li><a href="/registration/">Registration</a></li>
          <li><a href="/appraisal/">Appraisal</a></li>
          <li><a href="/breeds/">Breed standards</a></li>
          <li><a href="/code-of-ethics/">Code of Ethics</a></li>
        </ul>
      </div>
      <div>
        <h2>Contact</h2>
        <ul>
          <li><a href="/contact/">Contact us</a></li>
          <li><a href="mailto:{{ site.email.info }}">{{ site.email.info }}</a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>
